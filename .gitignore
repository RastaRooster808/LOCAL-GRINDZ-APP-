# ==========================================
# Web app (Vite + React + TypeScript)
# ==========================================

node_modules/
dist/
*.tsbuildinfo

# ==========================================
# Unreal Engine Standard Project Directories
# ==========================================

# Compiled binaries generated by the build system or IDEs
Binaries/
Plugins/*/Binaries/

# Local cache directory used for fast asset loading
DerivedDataCache/

# Intermediate files generated during compilation and cooking
Intermediate/
Plugins/*/Intermediate/

# Local saved data such as logs, configuration backups, and local builds
Saved/

# Build artifacts and generated project files
Build/

# Automatically generated architecture directories for specialized platforms
TargetPlatforms/

# ==========================================
# IDE and System Specific Files
# ==========================================

# Microsoft Visual Studio
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Xcode (macOS development)
*.xcodeproj
*.xcworkspace

# JetBrains Rider and CLion
.idea/

# Operating system
.DS_Store
Thumbs.db

# ==========================================
# Python Automation & Scripting Environment
# ==========================================

# Compiled bytecode (e.g. from py_compile syntax checks on tools/)
__pycache__/
*.pyc
*.pyo
*.pyd

# Local virtual environments used for testing toolchains locally
venv/
.venv/
env/
ENV/
build/
*.egg-info/

# ==========================================
# Security & Workspace Configurations
# ==========================================

# IMPORTANT: local configuration or environment files containing API keys,
# service keys, or studio tokens. Never commit these — the Supabase anon
# (publishable) key belongs in client code, but service keys never do.
.env
.env.local
.env.*.local
